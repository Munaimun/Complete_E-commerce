{
    "version": 2,
    "builds": [
      {
        "src": "api/index.mjs",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "/api/index.mjs"
      }
    ],
    "env": {
      "DB_HOST": "@db_host",
      "DB_PORT": "@db_port",
      "DB_USER": "@db_user",
      "DB_PASSWORD": "@db_password",
      "DB_NAME": "@db_name",
      "JWT_SECRET": "@jwt_secret",
      "ADMIN_SETUP_KEY": "@admin_setup_key"
    }
  }